# Copy to .env to pin your local dev ports (compose reads .env automatically).
#
# Local development defaults to host port 9878 for Floci so it never conflicts
# with another Floci instance on your machine (e.g. a release combined image
# running on the default 4566). Container-internal port is always 4566.
#
# The release combined image (ghcr.io/ofsazib/floci-dash:*-combined) ignores
# this file and uses Floci's default 4566 inside the container.
FLOCI_PORT=9878
DASHBOARD_PORT=9877
