# ─── Combined Floci + Dashboard with Docker-in-Docker ───
# Single container with internal Docker daemon for OpenSearch support.
# Does NOT require host Docker socket mount.
#
# Build: docker build -f docker/Dockerfile.combined -t floci-dash:combined .
# Run:   docker run --privileged -p 3000:3000 -p 4566:4566 -p 9400-9499:9400-9499 \
#          -v floci-data:/app/data -v floci-docker:/var/lib/docker floci-dash:combined

# Stage 1 — Build dashboard
FROM node:22-alpine AS dashboard-builder
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build

# Stage 2 — Runtime with Docker-in-Docker
FROM debian:bookworm-slim

ENV NODE_ENV=production
ENV DEBIAN_FRONTEND=noninteractive

USER root

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    lsb-release \
    procps \
    tini \
    && rm -rf /var/lib/apt/lists/*

# Install Docker engine
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo \
    "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian \
    $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
    tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        docker-ce \
        docker-ce-cli \
        containerd.io \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Copy Floci binary and gosu
COPY --from=floci/floci:latest /app/application /app/application
COPY --from=floci/floci:latest /usr/local/bin/gosu /usr/local/bin/gosu

# Create floci user
RUN groupadd -g 1001 floci && \
    useradd -r -u 1001 -g floci -d /app -s /sbin/nologin floci

# Create required directories
RUN mkdir -p /app/data \
             /var/run/docker \
             /var/lib/docker \
             /var/log

# Copy dashboard
WORKDIR /app/dashboard
RUN corepack enable && corepack prepare pnpm@latest --activate
COPY --from=dashboard-builder /app/dist ./dist
COPY --from=dashboard-builder /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod && \
    chown -R floci:floci /app/dashboard && \
    chmod -R a+rX /app/dashboard

# Copy entrypoint and healthcheck
COPY docker/combined-dind-entrypoint.sh /usr/local/bin/combined-entrypoint.sh
COPY docker/healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod +x /usr/local/bin/combined-entrypoint.sh /usr/local/bin/healthcheck.sh

# Configure Floci for Docker-in-Docker
# FLOCI_SERVICES_DOCKER_NETWORK is set dynamically in the entrypoint
# after creating the internal Docker network
ENV FLOCI_HOSTNAME=floci \
    FLOCI_STORAGE_MODE=hybrid \
    FLOCI_DOCKER_DOCKER_HOST=unix:///var/run/docker.sock \
    FLOCI_SERVICES_OPENSEARCH_MOCK=false \
    FLOCI_SERVICES_OPENSEARCH_PROXY_BASE_PORT=9400 \
    FLOCI_SERVICES_OPENSEARCH_PROXY_MAX_PORT=9499

EXPOSE 3000 4566 9400-9499

VOLUME ["/app/data", "/var/lib/docker"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh

WORKDIR /app

# tini as init for proper signal handling + process reaping
ENTRYPOINT ["tini", "--", "/usr/local/bin/combined-entrypoint.sh"]
